{
  "name": "dsh-scanf-reader",
  "version": "0.8.0",
  "type": "module",
  "license": "MIT",
  "description": "在 DSH 原生右侧面板中阅读 Scanf 文件结构和逻辑入口树。",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.2-rc.5 <0.3.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/IweirdoI/scanf.git",
    "directory": "adapters/dsh"
  },
  "homepage": "https://github.com/IweirdoI/scanf"
}
